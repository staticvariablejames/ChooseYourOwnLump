{
  "compilerOptions": {
    "target": "esnext",
    "module": "node16",
    "lib": ["esnext", "dom"],
    "types": [
        "vite/client",
        "cookieclicker"
    ],

    "moduleResolution": "node16",
    "noEmit": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true
  },
  "include": [
      "./"
  ]
}
